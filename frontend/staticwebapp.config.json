{
  "routes": [
    {
      "route": "/api/GetMyProfile",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/admin/*",
      "allowedRoles": ["admin"]
    },
    {
      "route": "/api/events/*",
      "allowedRoles": ["player", "gm", "admin"]
    }
  ],
  "responseOverrides": {
    "401": { "redirect": "/login", "statusCode": 302 }
  }
}

